{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":disableDependencyDashboard"
  ],
  "timezone": "Europe/London",
  "schedule": [
    "* 0-5 1 * *"
  ],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "rangeStrategy": "update-lockfile",
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "cargo dependencies"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchCurrentValue": "/^=/",
      "rangeStrategy": "pin",
      "groupName": "exact pins"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions",
      "pinDigests": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [
      "at any time"
    ],
    "automerge": true
  },
  "osvVulnerabilityAlerts": true
}
