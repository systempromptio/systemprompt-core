  "query": "\n            SELECT ip_address, COUNT(*) as session_count\n            FROM v_clean_traffic\n            WHERE started_at >= NOW() - INTERVAL '24 hours'\n              AND ip_address IS NOT NULL\n            GROUP BY ip_address\n            HAVING COUNT(*) >= $1\n            ",
