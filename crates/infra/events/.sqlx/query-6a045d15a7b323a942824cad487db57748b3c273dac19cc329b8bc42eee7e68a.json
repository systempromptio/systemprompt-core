  "query": "\n            SELECT\n                id as \"id: EventOutboxId\",\n                created_at,\n                channel,\n                user_id as \"user_id: UserId\",\n                payload,\n                origin_instance_id as \"origin_instance_id: InstanceId\",\n                deliver_to_origin\n            FROM event_outbox\n            WHERE created_at >= $1 AND (origin_instance_id <> $2 OR deliver_to_origin)\n            ORDER BY created_at, id\n            LIMIT $3\n            ",
