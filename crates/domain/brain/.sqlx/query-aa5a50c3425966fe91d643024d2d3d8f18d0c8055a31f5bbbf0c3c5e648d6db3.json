  "query": "SELECT subject_kind, subject_id, alias,\n                      similarity(alias_norm, $2)::float8 AS \"similarity!\"\n               FROM brain_aliases\n               WHERE subject_kind = $1 AND similarity(alias_norm, $2) >= $3::float4\n               ORDER BY 4 DESC, subject_id LIMIT 20",
