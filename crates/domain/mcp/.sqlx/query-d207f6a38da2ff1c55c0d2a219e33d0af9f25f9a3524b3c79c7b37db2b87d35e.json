  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                session_id as \"session_id!: SessionId\",\n                user_id as \"user_id: UserId\",\n                mcp_server_id,\n                last_event_id,\n                status as \"status!: McpSessionStatus\",\n                created_at as \"created_at!\",\n                last_activity_at as \"last_activity_at!\",\n                expires_at as \"expires_at!\"\n            FROM mcp_sessions\n            WHERE session_id = $1\n              AND status = 'active'\n              AND expires_at > NOW()\n            ",
