{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT t.device_id, t.provider, t.token, t.app_id\n            FROM user_device_push_tokens t\n            JOIN user_device_certs d ON d.id = t.device_id\n            WHERE t.user_id = $1 AND d.revoked_at IS NULL\n            ORDER BY t.registered_at, t.device_id\n            ",
