  "query": "\n            SELECT session_id, ip_address as \"ip_address!\"\n            FROM user_sessions\n            WHERE country IS NULL AND ip_address IS NOT NULL AND session_id > COALESCE($1::text, '')\n            ORDER BY session_id\n            LIMIT $2\n            ",
