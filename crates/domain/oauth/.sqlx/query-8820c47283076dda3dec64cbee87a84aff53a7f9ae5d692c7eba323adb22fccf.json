  "query": "\n            UPDATE bridge_exchange_codes\n            SET consumed_at = CURRENT_TIMESTAMP\n            WHERE code_hash = $1\n              AND consumed_at IS NULL\n              AND expires_at > CURRENT_TIMESTAMP\n            RETURNING user_id, ui_client_id, ui_redirect_uri, ui_scope, ui_code_challenge,\n                      ui_authenticated_at\n            ",
